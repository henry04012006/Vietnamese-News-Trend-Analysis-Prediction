{
  "source": "Tuổi Trẻ",
  "timezone": "Asia/Ho_Chi_Minh",
  "allowed_hosts": ["tuoitre.vn"],
  "allowed_schemes": ["https", "http"],
  "robots_url": "https://tuoitre.vn/robots.txt",
  "sitemap_index": "https://tuoitre.vn/sitemaps/index.rss",
  "sitemap_namespace": "http://www.sitemaps.org/schemas/sitemap/0.9",
  "sitemap_pattern": "/StaticSitemaps/sitemaps-(?P<year>\\d{4})-(?P<month>\\d{1,2})-(?P<day>\\d{1,2})-(?P<last_day>\\d{1,2})\\.xml$",
  "additional_sitemap_indexes": [
    {"url": "https://tuoitre.vn/sitemaps/video.rss", "pattern": "/StaticSitemaps/sitemaps-video-(?P<year>\\d{4})-(?P<month>\\d{1,2})-(?P<day>\\d{1,2})-(?P<last_day>\\d{1,2})\\.xml$"}
  ],
  "sitemap_boundary_overlap_days": 1,
  "article_path_pattern": "-\\d+\\.htm$",
  "start_date": "2026-01-01",
  "end_date": null,
  "sitemap_lookback_months": 1,
  "http": {
    "user_agent": "VietnameseNewsResearch/0.1 (academic dataset collection)",
    "timeout_seconds": 30,
    "delay_seconds": 1,
    "workers": 1,
    "prefetch": 1,
    "attempts": 3,
    "backoff_seconds": 5,
    "retry_statuses": [500, 502, 503, 504],
    "retry_exceptions": ["Timeout", "ConnectionError", "HTTPError", "ChunkedEncodingError"],
    "stop_statuses": [401, 403, 429],
    "max_redirects": 5
  },
  "url": {
    "tracking_keys": ["fbclid", "gclid", "dclid", "mc_cid", "mc_eid"],
    "tracking_prefixes": ["utm_"],
    "id_separator": "|"
  },
  "selectors": {
    "title": "h1.detail-title",
    "body": ".detail-content",
    "publication": "time[itemprop='datePublished'][datetime]",
    "publication_attribute": "datetime",
    "publication_fallback": "meta[property='article:published_time']",
    "publication_fallback_attribute": "content",
    "description": ".detail-sapo",
    "category_links": ".detail-cate a[href]",
    "category_meta": "meta[property='article:section']",
    "category_attribute": "content",
    "structured_data": "script[type='application/ld+json']",
    "category_article_links": "a.box-category-link-title[href], a.box-title[href]",
    "blocks": "p, h2, h3, li",
    "remove": "script, style, iframe, figure, figcaption, [type='RelatedNewsBox'], [type='RelatedOneNews'], .VCSortableInPreviewMode[type='RelatedNews'], .box-tin-lien-quan, .content-related, .ads, [data-ad]"
  },
  "output": {
    "directory": "data/tuoitre",
    "csv_field_limit": 16777216,
    "json_temp_suffix": ".tmp",
    "console_report_fields": ["mode", "status", "discovered", "attempted", "saved", "total_valid", "pending_count", "date_cache_skips", "result_counts", "valid_by_category"],
    "journal": "{mode}_results.jsonl",
    "process_info": "process.json",
    "resume_validation": "resume_validation.json",
    "speed_validation": "speed_validation.json",
    "rapid_speed_validation": "rapid_speed_validation.json",
    "stdout": "crawl_stdout.log",
    "stderr": "crawl_stderr.log",
    "backfill_memory_fields": ["article_id", "url", "published_at", "category"],
    "encoding": "utf-8-sig",
    "sample_csv": "sample_tuoitre.csv",
    "category_sample_csv": "sample_tuoitre_categories.csv",
    "sample_before_categories_csv": "sample_tuoitre_before_categories.csv",
    "monthly_csv": "tuoitre_{month}.csv",
    "errors": "{mode}_errors.jsonl",
    "report": "{mode}_report.json",
    "manifest": "{mode}_urls.json",
    "html_directory": "sample_html",
    "category_html_directory": "category_sample_html",
    "html_filename": "{article_id}.html",
    "lock": ".crawl.lock",
    "paragraph_separator": "\n\n",
    "fields": ["article_id", "title", "content", "source", "url", "published_at", "collected_at", "description", "category"],
    "required_fields": ["article_id", "title", "content", "source", "url", "published_at", "collected_at", "category"]
  },
  "validation": {
    "short_content_chars": 200,
    "sample_min_valid": 27,
    "sample_min_months": 2,
    "manual_review_count": 5
  },
  "sample": {"recent_count": 20, "old_count": 10},
  "categories": [
    {"name": "Video", "url": "https://tuoitre.vn/video.htm", "article_path_prefix": "/video/", "description_as_content": true},
    {"name": "Thời sự", "url": "https://tuoitre.vn/thoi-su.htm"},
    {"name": "Thế giới", "url": "https://tuoitre.vn/the-gioi.htm"},
    {"name": "Pháp luật", "url": "https://tuoitre.vn/phap-luat.htm"},
    {"name": "Kinh doanh", "url": "https://tuoitre.vn/kinh-doanh.htm"},
    {"name": "Công nghệ", "url": "https://tuoitre.vn/cong-nghe.htm"},
    {"name": "Xe", "url": "https://tuoitre.vn/xe.htm"},
    {"name": "Du lịch", "url": "https://tuoitre.vn/du-lich.htm"},
    {"name": "Nhịp sống trẻ", "url": "https://tuoitre.vn/nhip-song-tre.htm"},
    {"name": "Văn hóa", "url": "https://tuoitre.vn/van-hoa.htm"},
    {"name": "Giải trí", "url": "https://tuoitre.vn/giai-tri.htm"},
    {"name": "Thể thao", "url": "https://tuoitre.vn/the-thao.htm"},
    {"name": "Giáo dục", "url": "https://tuoitre.vn/giao-duc.htm"},
    {"name": "Nhà đất", "url": "https://tuoitre.vn/nha-dat.htm", "aliases": ["Bất động sản"]},
    {"name": "Sức khỏe", "url": "https://tuoitre.vn/suc-khoe.htm"},
    {"name": "Giả - Thật", "url": "https://tuoitre.vn/gia-that.htm", "aliases": ["Giả thật", "Giả-thật"]},
    {"name": "Bạn đọc", "url": "https://tuoitre.vn/ban-doc.htm"},
    {"name": "Khoa học", "url": "https://tuoitre.vn/khoa-hoc.htm"}
  ],
  "category_sample": {"per_category": 2, "max_candidates": 6},
  "backfill": {"max_attempts_per_run": null, "retry_errors_on_resume": true},
  "date_cache": {
    "enabled": true,
    "journal_globs": ["data/tuoitre/pilot_2026-01/backfill_results.jsonl", "data/tuoitre/monthly/*/backfill_results.jsonl"],
    "trusted_statuses": ["saved", "outside_range"],
    "checkpoint_every": 250
  },
  "monthly": {
    "directory": "data/tuoitre/monthly",
    "month_directory_template": "{month}",
    "existing_month_directories": {"2026-01": "data/tuoitre/pilot_2026-01"},
    "status": "monthly_status.json",
    "lock": ".monthly.lock",
    "job_config": "crawl_config.json",
    "continue_on_article_errors": true,
    "summary_fields": ["total_valid", "pending_count", "date_cache_skips", "result_counts", "duplicate_urls", "duplicate_ids", "missing_required_rows"]
  },
  "category_routes": [{"path": "/chung-khoan", "category": "Kinh doanh"}],
  "excluded_categories": [
    {"path": "/can-biet", "name": "Cần biết"},
    {"path": "/thu-gian", "name": "Thư giãn"},
    {"path": "/thoi-tiet", "name": "Thời tiết"}
  ],
  "progress_every": 10
}
